# API Key de CapSolver (https://www.capsolver.com)
CAPSOLVER_API_KEY=CAP-XXXXX-tu-api-key

# MariaDB / MySQL
MARIADB_HOST=localhost
MARIADB_PORT=3306
MARIADB_USER=root
MARIADB_PASSWORD=
MARIADB_DATABASE=soat

# (Opcional) Forzar la version mayor de Chrome que usa ChromeDriver.
# Solo si la deteccion automatica falla en tu entorno. Ejemplo: 152
# CHROME_VERSION_MAIN=152

# Webhook Sunarp (operacion insertar_vehiculo)
WEBHOOK_SUNARP_URL=
# (Opcional) si se define, se envia como "Authorization: Bearer <token>"
WEBHOOK_SUNARP_TOKEN=
# Reintentos del INSERT ante timeout/5xx (0-2). Dejar en 0 hasta confirmar el UNIQUE en produccion
WEBHOOK_SUNARP_INSERT_RETRIES=0
# Clientes Sunarp simultaneos (compartido por sync y async) y espera maxima del sync antes de 503
SUNARP_POOL_SIZE=5
SUNARP_SYNC_WAIT_SECONDS=30

# OCR de Sunarp (Tesseract). Vacio = autodeteccion (rutas tipicas de Windows / PATH)
TESSERACT_CMD=
# Preprocesado (gris + ampliar + umbral) y modo de segmentacion: auto (compara psm 6 y 4) | 6 | 4
SUNARP_OCR_PREPROCESS=1
SUNARP_OCR_SCALE=2
SUNARP_OCR_THRESHOLD=150
SUNARP_OCR_PSM=auto
